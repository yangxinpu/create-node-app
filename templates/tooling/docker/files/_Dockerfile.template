{{#if dockerVariant=node-typescript}}
FROM node:{{runtimeVersion}}-alpine AS builder
WORKDIR /app
COPY package*.json ./
RUN npm install
COPY . .
RUN npm run build

FROM node:{{runtimeVersion}}-alpine
WORKDIR /app
ENV NODE_ENV=production
COPY --from=builder /app/dist ./dist
COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/package.json ./package.json
COPY --from=builder /app/web ./web
EXPOSE 3000
CMD ["node", "dist/index.js"]
{{/if}}
{{#if dockerVariant=node-javascript}}
FROM node:{{runtimeVersion}}-alpine
WORKDIR /app
ENV NODE_ENV=production
COPY package*.json ./
RUN npm install --omit=dev
COPY . .
EXPOSE 3000
CMD ["node", "src/index.js"]
{{/if}}
{{#if runtime=bun}}
FROM oven/bun:{{runtimeVersion}}-alpine
WORKDIR /app
ENV NODE_ENV=production
COPY package.json ./
RUN bun install --production
COPY . .
EXPOSE 3000
CMD ["bun", "{{runtimeEntry}}"]
{{/if}}
