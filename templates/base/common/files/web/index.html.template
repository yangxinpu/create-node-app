<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="{{projectName}} was generated with create-node-app." />
    <title>{{projectName}} | create-node-app</title>
    <style>
      :root {
        color-scheme: light;
        font-family:
          Inter,
          ui-sans-serif,
          system-ui,
          -apple-system,
          BlinkMacSystemFont,
          'Segoe UI',
          sans-serif;
        color: #18181b;
        background: #f5f7f8;
        font-synthesis: none;
        text-rendering: optimizeLegibility;
      }

      * {
        box-sizing: border-box;
      }

      body {
        min-width: 320px;
        min-height: 100vh;
        margin: 0;
        background: #f5f7f8;
      }

      button,
      a {
        color: inherit;
        font: inherit;
      }

      .shell {
        width: min(1080px, calc(100% - 40px));
        margin: 0 auto;
      }

      .topbar {
        border-bottom: 1px solid #d7dde2;
        background: rgba(245, 247, 248, 0.96);
      }

      .topbar-inner {
        display: flex;
        min-height: 64px;
        align-items: center;
        justify-content: space-between;
        gap: 20px;
      }

      .brand {
        display: inline-flex;
        align-items: center;
        gap: 12px;
        font-weight: 750;
      }

      .brand-mark {
        display: grid;
        width: 36px;
        height: 36px;
        place-items: center;
        border: 1px solid #18181b;
        border-radius: 6px;
        background: #18181b;
        color: #ffffff;
        font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
        font-size: 12px;
      }

      .language-switch {
        display: inline-flex;
        height: 34px;
        align-items: center;
        border: 1px solid #cbd2d9;
        border-radius: 6px;
        padding: 3px;
        background: #ffffff;
      }

      .language-switch button {
        min-width: 42px;
        height: 26px;
        border: 0;
        border-radius: 4px;
        padding: 0 9px;
        background: transparent;
        color: #667085;
        cursor: pointer;
        font-size: 12px;
        font-weight: 750;
      }

      .language-switch button[aria-pressed='true'] {
        background: #e8edf0;
        color: #17191d;
      }

      .language-switch button:focus-visible,
      .action:focus-visible {
        outline: 3px solid rgba(8, 145, 178, 0.3);
        outline-offset: 2px;
      }

      main {
        padding: 72px 0 56px;
      }

      .intro {
        display: grid;
        grid-template-columns: minmax(0, 1fr) 280px;
        gap: 64px;
        align-items: center;
        padding-bottom: 64px;
      }

      h1,
      h2,
      p {
        margin-top: 0;
      }

      h1 {
        max-width: 720px;
        margin-bottom: 18px;
        color: #101114;
        font-size: 54px;
        line-height: 1.06;
        overflow-wrap: anywhere;
      }

      .lede {
        max-width: 650px;
        margin-bottom: 28px;
        color: #5c6673;
        font-size: 18px;
        line-height: 1.7;
      }

      .actions {
        display: flex;
        flex-wrap: wrap;
        gap: 12px;
      }

      .action {
        display: inline-flex;
        min-height: 42px;
        align-items: center;
        justify-content: center;
        gap: 9px;
        border: 1px solid #c7ced6;
        border-radius: 6px;
        padding: 0 16px;
        background: #ffffff;
        color: #25282d;
        cursor: pointer;
        font-size: 14px;
        font-weight: 700;
        text-decoration: none;
        transition:
          border-color 160ms ease,
          background 160ms ease,
          color 160ms ease;
      }

      .action:hover {
        border-color: #64748b;
        background: #f9fafb;
      }

      .action.request {
        border-color: #047857;
        background: #047857;
        color: #ffffff;
      }

      .action.request:hover {
        border-color: #065f46;
        background: #065f46;
      }

      .action:disabled {
        cursor: wait;
        opacity: 0.65;
      }

      .action svg {
        width: 18px;
        height: 18px;
        flex: none;
        stroke-width: 2;
      }

      .response-box {
        display: grid;
        min-height: 62px;
        grid-template-columns: 120px minmax(0, 1fr);
        align-items: center;
        gap: 16px;
        margin-top: 16px;
        border: 1px solid #d2d8de;
        border-radius: 6px;
        padding: 12px 16px;
        background: #ffffff;
      }

      .response-box span {
        color: #78828e;
        font-size: 12px;
        font-weight: 750;
        text-transform: uppercase;
      }

      .response-box output {
        color: #1e2024;
        font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
        font-size: 14px;
        overflow-wrap: anywhere;
      }

      .response-box output[data-state='success'] {
        color: #047857;
        font-weight: 750;
      }

      .response-box output[data-state='error'] {
        color: #b91c1c;
      }

      .runtime-panel {
        min-height: 220px;
        border: 1px solid #cfd6dc;
        border-radius: 8px;
        padding: 24px;
        background: #15171b;
        color: #ffffff;
        box-shadow: 12px 12px 0 #d8dde1;
      }

      .terminal-dots {
        display: flex;
        gap: 7px;
        margin-bottom: 34px;
      }

      .terminal-dots span {
        width: 9px;
        height: 9px;
        border-radius: 50%;
      }

      .terminal-dots span:nth-child(1) {
        background: #f43f5e;
      }

      .terminal-dots span:nth-child(2) {
        background: #f59e0b;
      }

      .terminal-dots span:nth-child(3) {
        background: #22c55e;
      }

      .terminal-label {
        margin-bottom: 8px;
        color: #8f9aa8;
        font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
        font-size: 12px;
        text-transform: uppercase;
      }

      .runtime-value {
        margin-bottom: 28px;
        font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
        font-size: 21px;
        line-height: 1.4;
      }

      .health-state {
        display: flex;
        min-height: 24px;
        align-items: center;
        gap: 9px;
        color: #a7f3d0;
        font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
        font-size: 13px;
      }

      .health-state::before {
        width: 8px;
        height: 8px;
        border-radius: 50%;
        background: #22c55e;
        content: '';
      }

      .health-state[data-state='error'] {
        color: #fecaca;
      }

      .health-state[data-state='error']::before {
        background: #ef4444;
      }

      .section-heading {
        margin-bottom: 20px;
      }

      h2 {
        margin-bottom: 0;
        font-size: 26px;
        line-height: 1.25;
      }

      .stack-grid {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: 12px;
      }

      .stack-item {
        min-width: 0;
        min-height: 108px;
        border: 1px solid #d2d8de;
        border-radius: 8px;
        padding: 18px;
        background: #ffffff;
      }

      .stack-item span {
        display: block;
        margin-bottom: 16px;
        color: #78828e;
        font-size: 12px;
        font-weight: 700;
        text-transform: uppercase;
      }

      .stack-item strong {
        display: block;
        color: #1e2024;
        font-size: 17px;
        line-height: 1.35;
        overflow-wrap: anywhere;
      }

      footer {
        border-top: 1px solid #d7dde2;
        padding: 24px 0 32px;
        color: #737d89;
        font-size: 13px;
      }

      footer a {
        font-weight: 700;
        text-decoration: none;
      }

      footer a:hover {
        text-decoration: underline;
      }

      @media (max-width: 820px) {
        main {
          padding-top: 48px;
        }

        .intro {
          grid-template-columns: 1fr;
          gap: 36px;
        }

        .runtime-panel {
          min-height: 190px;
        }

        .stack-grid {
          grid-template-columns: repeat(2, minmax(0, 1fr));
        }
      }

      @media (max-width: 520px) {
        .shell {
          width: min(100% - 28px, 1080px);
        }

        .topbar-inner {
          min-height: 58px;
        }

        main {
          padding-top: 36px;
        }

        .intro {
          padding-bottom: 48px;
        }

        h1 {
          font-size: 38px;
        }

        .lede {
          font-size: 16px;
        }

        .action {
          width: 100%;
        }

        .response-box {
          grid-template-columns: 1fr;
          gap: 6px;
        }

        .stack-grid {
          grid-template-columns: 1fr;
        }
      }

      @media (prefers-reduced-motion: reduce) {
        *,
        *::before,
        *::after {
          scroll-behavior: auto !important;
          transition-duration: 0.01ms !important;
        }
      }
    </style>
  </head>
  <body>
    <header class="topbar">
      <div class="shell topbar-inner">
        <div class="brand">
          <span class="brand-mark" aria-hidden="true">CNA</span>
          <span>create-node-app</span>
        </div>
        <div class="language-switch" role="group" aria-label="Language / 语言">
          <button type="button" data-language="en" aria-pressed="true">EN</button>
          <button type="button" data-language="zh" aria-pressed="false">中文</button>
        </div>
      </div>
    </header>

    <main class="shell">
      <section class="intro" aria-labelledby="project-title">
        <div>
          <h1 id="project-title">{{projectName}}</h1>
          <p class="lede" data-i18n="intro">
            Your generated backend is running. The selected stack is wired together and ready for
            application code.
          </p>
          <div class="actions">
            <button id="hello-button" class="action request" type="button">
              <svg
                aria-hidden="true"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <path d="m22 2-7 20-4-9-9-4Z"></path>
                <path d="M22 2 11 13"></path>
              </svg>
              <span data-i18n="requestGreeting">Request greeting</span>
            </button>
            <a
              class="action"
              href="https://github.com/yangxinpu/create-node-app"
              target="_blank"
              rel="noreferrer"
            >
              <svg
                aria-hidden="true"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <path
                  d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3.3-.4 6.8-1.6 6.8-7A5.4 5.4 0 0 0 19.4 4 5 5 0 0 0 19.3.5S18.2.1 15 1.8a13.4 13.4 0 0 0-7 0C4.8.1 3.7.5 3.7.5A5 5 0 0 0 3.6 4a5.4 5.4 0 0 0-1.4 3.7c0 5.4 3.5 6.6 6.8 7A4.8 4.8 0 0 0 8 18v4"
                ></path>
                <path d="M8 19c-3 .9-3-1.5-4-2"></path>
              </svg>
              <span data-i18n="viewGenerator">View on GitHub</span>
            </a>
          </div>
          <div class="response-box" aria-live="polite">
            <span data-i18n="responseLabel">Backend response</span>
            <output id="hello-output" data-state="idle" data-i18n="responseIdle">
              Waiting for a request
            </output>
          </div>
        </div>

        <aside class="runtime-panel" aria-label="Runtime status">
          <div class="terminal-dots" aria-hidden="true">
            <span></span>
            <span></span>
            <span></span>
          </div>
          <p class="terminal-label" data-i18n="runtime">Runtime</p>
          <p class="runtime-value">{{runtimeDisplay}}</p>
          <div id="health-state" class="health-state" aria-live="polite" data-state="loading">
            <span data-i18n="healthChecking">Checking /health</span>
          </div>
        </aside>
      </section>

      <section aria-labelledby="stack-title">
        <div class="section-heading">
          <h2 id="stack-title" data-i18n="selectedStack">Your selected stack</h2>
        </div>

        <div class="stack-grid">
          <article class="stack-item">
            <span data-i18n="runtime">Runtime</span>
            <strong>{{runtimeDisplay}}</strong>
          </article>
          <article class="stack-item">
            <span data-i18n="language">Language</span>
            <strong>{{languageDisplay}}</strong>
          </article>
          <article class="stack-item">
            <span data-i18n="framework">Framework</span>
            <strong>{{frameworkDisplay}}</strong>
          </article>
          <article class="stack-item">
            <span data-i18n="architecture">Architecture</span>
            <strong>{{architectureDisplay}}</strong>
          </article>
          <article class="stack-item">
            <span data-i18n="database">Database</span>
            <strong>{{databaseDisplay}}</strong>
          </article>
          <article class="stack-item">
            <span data-i18n="orm">ORM</span>
            <strong>{{ormDisplay}}</strong>
          </article>
          <article class="stack-item">
            <span data-i18n="cache">Cache</span>
            <strong>{{cacheDisplay}}</strong>
          </article>
          <article class="stack-item">
            <span data-i18n="tooling">Tooling</span>
            <strong>{{toolingDisplay}}</strong>
          </article>
        </div>
      </section>
    </main>

    <footer>
      <div class="shell">
        <span data-i18n="generatedWith">Generated with</span>
        <a href="https://github.com/yangxinpu/create-node-app">create-node-app</a>.
      </div>
    </footer>

    <script>
      const messages = {
        en: {
          intro:
            'Your generated backend is running. The selected stack is wired together and ready for application code.',
          requestGreeting: 'Request greeting',
          viewGenerator: 'View on GitHub',
          responseLabel: 'Backend response',
          responseIdle: 'Waiting for a request',
          responseLoading: 'Requesting...',
          responseError: 'Request failed',
          runtime: 'Runtime',
          healthChecking: 'Checking /health',
          healthHealthy: 'Healthy /health endpoint',
          healthResponded: 'Health endpoint responded',
          healthUnavailable: 'Health endpoint unavailable',
          selectedStack: 'Your selected stack',
          language: 'Language',
          framework: 'Framework',
          architecture: 'Architecture',
          database: 'Database',
          orm: 'ORM',
          cache: 'Cache',
          tooling: 'Tooling',
          generatedWith: 'Generated with',
        },
        zh: {
          intro: '生成的后端服务已启动，所选技术栈已完成组合，可以开始编写应用代码。',
          requestGreeting: '请求后端',
          viewGenerator: '查看 GitHub',
          responseLabel: '后端响应',
          responseIdle: '等待发起请求',
          responseLoading: '请求中...',
          responseError: '请求失败',
          runtime: '运行时',
          healthChecking: '正在检查 /health',
          healthHealthy: '/health 运行正常',
          healthResponded: '健康检查已响应',
          healthUnavailable: '健康检查不可用',
          selectedStack: '已选择的技术栈',
          language: '语言',
          framework: '框架',
          architecture: '项目结构',
          database: '数据库',
          orm: 'ORM',
          cache: '缓存',
          tooling: '工程工具',
          generatedWith: '生成工具',
        },
      }

      const languageButtons = document.querySelectorAll('[data-language]')
      const helloButton = document.querySelector('#hello-button')
      const helloOutput = document.querySelector('#hello-output')
      const healthState = document.querySelector('#health-state')
      let currentLanguage = navigator.language.toLowerCase().startsWith('zh') ? 'zh' : 'en'
      let healthResult = 'healthChecking'
      let responseState = 'idle'

      function translatePage(language) {
        currentLanguage = language
        document.documentElement.lang = language === 'zh' ? 'zh-CN' : 'en'

        document.querySelectorAll('[data-i18n]').forEach((element) => {
          const key = element.dataset.i18n
          if (key && messages[language][key]) {
            element.textContent = messages[language][key]
          }
        })

        languageButtons.forEach((button) => {
          button.setAttribute('aria-pressed', String(button.dataset.language === language))
        })

        healthState.querySelector('span').textContent = messages[language][healthResult]
        if (responseState !== 'success') {
          const responseKey =
            responseState === 'loading'
              ? 'responseLoading'
              : responseState === 'error'
                ? 'responseError'
                : 'responseIdle'
          helloOutput.textContent = messages[language][responseKey]
        }
      }

      languageButtons.forEach((button) => {
        button.addEventListener('click', () => translatePage(button.dataset.language))
      })

      helloButton.addEventListener('click', () => {
        responseState = 'loading'
        helloButton.disabled = true
        helloOutput.dataset.state = 'loading'
        helloOutput.textContent = messages[currentLanguage].responseLoading

        fetch('/api/hello', { headers: { accept: 'application/json' } })
          .then((response) => {
            if (!response.ok) throw new Error(`HTTP ${response.status}`)
            return response.json()
          })
          .then((data) => {
            responseState = 'success'
            helloOutput.dataset.state = 'success'
            helloOutput.textContent = data.message
          })
          .catch(() => {
            responseState = 'error'
            helloOutput.dataset.state = 'error'
            helloOutput.textContent = messages[currentLanguage].responseError
          })
          .finally(() => {
            helloButton.disabled = false
          })
      })

      fetch('/health', { headers: { accept: 'application/json' } })
        .then((response) => {
          if (!response.ok) throw new Error(`HTTP ${response.status}`)
          return response.json()
        })
        .then((health) => {
          healthResult = health.status === 'ok' ? 'healthHealthy' : 'healthResponded'
          healthState.querySelector('span').textContent = messages[currentLanguage][healthResult]
          healthState.dataset.state = 'success'
        })
        .catch(() => {
          healthResult = 'healthUnavailable'
          healthState.querySelector('span').textContent = messages[currentLanguage][healthResult]
          healthState.dataset.state = 'error'
        })

      translatePage(currentLanguage)
    </script>
  </body>
</html>
