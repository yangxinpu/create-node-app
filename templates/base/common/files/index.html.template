<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="{{projectName}} was generated with create-node-app." />
    <title>{{projectName}} | create-node-app</title>
    <style>
      :root {
        color-scheme: light;
        font-family:
          Inter,
          ui-sans-serif,
          system-ui,
          -apple-system,
          BlinkMacSystemFont,
          'Segoe UI',
          sans-serif;
        color: #18181b;
        background: #f5f7f8;
        font-synthesis: none;
        text-rendering: optimizeLegibility;
      }

      * {
        box-sizing: border-box;
      }

      body {
        min-width: 320px;
        min-height: 100vh;
        margin: 0;
        background: #f5f7f8;
      }

      a {
        color: inherit;
      }

      .shell {
        width: min(1080px, calc(100% - 40px));
        margin: 0 auto;
      }

      .topbar {
        border-bottom: 1px solid #d7dde2;
        background: rgba(245, 247, 248, 0.94);
      }

      .topbar-inner {
        display: flex;
        min-height: 64px;
        align-items: center;
        justify-content: space-between;
        gap: 20px;
      }

      .brand {
        display: inline-flex;
        align-items: center;
        gap: 12px;
        font-weight: 750;
      }

      .brand-mark {
        display: grid;
        width: 36px;
        height: 36px;
        place-items: center;
        border: 1px solid #18181b;
        border-radius: 6px;
        background: #18181b;
        color: #ffffff;
        font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
        font-size: 12px;
      }

      .topbar-meta {
        color: #667085;
        font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
        font-size: 13px;
      }

      main {
        padding: 72px 0 56px;
      }

      .intro {
        display: grid;
        grid-template-columns: minmax(0, 1fr) 280px;
        gap: 64px;
        align-items: center;
        padding-bottom: 64px;
      }

      .eyebrow {
        display: flex;
        align-items: center;
        gap: 9px;
        margin: 0 0 18px;
        color: #166534;
        font-size: 13px;
        font-weight: 750;
        text-transform: uppercase;
      }

      .status-dot {
        width: 9px;
        height: 9px;
        border-radius: 50%;
        background: #16a34a;
        box-shadow: 0 0 0 4px #dcfce7;
      }

      h1,
      h2,
      p {
        margin-top: 0;
      }

      h1 {
        max-width: 720px;
        margin-bottom: 18px;
        color: #101114;
        font-size: 54px;
        line-height: 1.06;
        overflow-wrap: anywhere;
      }

      .lede {
        max-width: 650px;
        margin-bottom: 28px;
        color: #5c6673;
        font-size: 18px;
        line-height: 1.7;
      }

      .actions {
        display: flex;
        flex-wrap: wrap;
        gap: 12px;
      }

      .action {
        display: inline-flex;
        min-height: 42px;
        align-items: center;
        justify-content: center;
        border: 1px solid #c7ced6;
        border-radius: 6px;
        padding: 0 16px;
        background: #ffffff;
        color: #25282d;
        font-size: 14px;
        font-weight: 700;
        text-decoration: none;
        transition:
          border-color 160ms ease,
          background 160ms ease,
          color 160ms ease;
      }

      .action:hover {
        border-color: #18181b;
        background: #f9fafb;
      }

      .action.primary {
        border-color: #18181b;
        background: #18181b;
        color: #ffffff;
      }

      .action.primary:hover {
        background: #303238;
      }

      .runtime-panel {
        min-height: 220px;
        border: 1px solid #cfd6dc;
        border-radius: 8px;
        padding: 24px;
        background: #15171b;
        color: #ffffff;
        box-shadow: 12px 12px 0 #d8dde1;
      }

      .terminal-dots {
        display: flex;
        gap: 7px;
        margin-bottom: 34px;
      }

      .terminal-dots span {
        width: 9px;
        height: 9px;
        border-radius: 50%;
      }

      .terminal-dots span:nth-child(1) {
        background: #f43f5e;
      }

      .terminal-dots span:nth-child(2) {
        background: #f59e0b;
      }

      .terminal-dots span:nth-child(3) {
        background: #22c55e;
      }

      .terminal-label {
        margin-bottom: 8px;
        color: #8f9aa8;
        font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
        font-size: 12px;
        text-transform: uppercase;
      }

      .runtime-value {
        margin-bottom: 28px;
        font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
        font-size: 21px;
        line-height: 1.4;
      }

      .health-state {
        display: flex;
        min-height: 24px;
        align-items: center;
        gap: 9px;
        color: #a7f3d0;
        font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
        font-size: 13px;
      }

      .health-state::before {
        width: 8px;
        height: 8px;
        border-radius: 50%;
        background: #22c55e;
        content: '';
      }

      .health-state[data-state='error'] {
        color: #fecaca;
      }

      .health-state[data-state='error']::before {
        background: #ef4444;
      }

      .section-heading {
        display: flex;
        align-items: end;
        justify-content: space-between;
        gap: 24px;
        margin-bottom: 20px;
      }

      .section-label {
        margin-bottom: 7px;
        color: #7c3aed;
        font-size: 12px;
        font-weight: 800;
        text-transform: uppercase;
      }

      h2 {
        margin-bottom: 0;
        font-size: 26px;
        line-height: 1.25;
      }

      .module-count {
        flex: none;
        color: #667085;
        font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
        font-size: 13px;
      }

      .stack-grid {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: 12px;
      }

      .stack-item {
        min-width: 0;
        min-height: 108px;
        border: 1px solid #d2d8de;
        border-radius: 8px;
        padding: 18px;
        background: #ffffff;
      }

      .stack-item span {
        display: block;
        margin-bottom: 16px;
        color: #78828e;
        font-size: 12px;
        font-weight: 700;
        text-transform: uppercase;
      }

      .stack-item strong {
        display: block;
        color: #1e2024;
        font-size: 17px;
        line-height: 1.35;
        overflow-wrap: anywhere;
      }

      .stack-item:nth-child(4n + 1) {
        border-top: 3px solid #16a34a;
      }

      .stack-item:nth-child(4n + 2) {
        border-top: 3px solid #0891b2;
      }

      .stack-item:nth-child(4n + 3) {
        border-top: 3px solid #d97706;
      }

      .stack-item:nth-child(4n + 4) {
        border-top: 3px solid #c026d3;
      }

      .modules {
        margin-top: 28px;
        border-left: 3px solid #18181b;
        padding: 4px 0 4px 18px;
      }

      .modules span {
        display: block;
        margin-bottom: 8px;
        color: #667085;
        font-size: 13px;
        font-weight: 700;
      }

      .modules code {
        color: #333840;
        font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
        font-size: 13px;
        line-height: 1.8;
        overflow-wrap: anywhere;
      }

      footer {
        border-top: 1px solid #d7dde2;
        padding: 24px 0 32px;
        color: #737d89;
        font-size: 13px;
      }

      footer a {
        font-weight: 700;
        text-decoration: none;
      }

      footer a:hover {
        text-decoration: underline;
      }

      @media (max-width: 820px) {
        main {
          padding-top: 48px;
        }

        .intro {
          grid-template-columns: 1fr;
          gap: 36px;
        }

        .runtime-panel {
          min-height: 190px;
        }

        .stack-grid {
          grid-template-columns: repeat(2, minmax(0, 1fr));
        }
      }

      @media (max-width: 520px) {
        .shell {
          width: min(100% - 28px, 1080px);
        }

        .topbar-inner {
          min-height: 58px;
        }

        .topbar-meta {
          display: none;
        }

        main {
          padding-top: 36px;
        }

        .intro {
          padding-bottom: 48px;
        }

        h1 {
          font-size: 38px;
        }

        .lede {
          font-size: 16px;
        }

        .action {
          width: 100%;
        }

        .section-heading {
          align-items: start;
          flex-direction: column;
          gap: 8px;
        }

        .stack-grid {
          grid-template-columns: 1fr;
        }
      }

      @media (prefers-reduced-motion: reduce) {
        *,
        *::before,
        *::after {
          scroll-behavior: auto !important;
          transition-duration: 0.01ms !important;
        }
      }
    </style>
  </head>
  <body>
    <header class="topbar">
      <div class="shell topbar-inner">
        <div class="brand">
          <span class="brand-mark" aria-hidden="true">CNA</span>
          <span>create-node-app</span>
        </div>
        <span class="topbar-meta">{{architectureDisplay}} architecture</span>
      </div>
    </header>

    <main class="shell">
      <section class="intro" aria-labelledby="project-title">
        <div>
          <p class="eyebrow"><span class="status-dot" aria-hidden="true"></span>Server ready</p>
          <h1 id="project-title">{{projectName}}</h1>
          <p class="lede">
            Your generated backend is running. The selected stack is wired together and ready for
            application code.
          </p>
          <div class="actions">
            <a class="action primary" href="/health">Open health endpoint</a>
            <a
              class="action"
              href="https://github.com/yangxinpu/create-node-app"
              target="_blank"
              rel="noreferrer"
            >
              View generator
            </a>
          </div>
        </div>

        <aside class="runtime-panel" aria-label="Runtime status">
          <div class="terminal-dots" aria-hidden="true">
            <span></span>
            <span></span>
            <span></span>
          </div>
          <p class="terminal-label">Runtime</p>
          <p class="runtime-value">{{runtimeDisplay}}</p>
          <div id="health-state" class="health-state" aria-live="polite">Checking /health</div>
        </aside>
      </section>

      <section aria-labelledby="stack-title">
        <div class="section-heading">
          <div>
            <p class="section-label">Configuration</p>
            <h2 id="stack-title">Your selected stack</h2>
          </div>
          <span class="module-count">{{templateCount}} template modules</span>
        </div>

        <div class="stack-grid">
          <article class="stack-item">
            <span>Runtime</span>
            <strong>{{runtimeDisplay}}</strong>
          </article>
          <article class="stack-item">
            <span>Language</span>
            <strong>{{languageDisplay}}</strong>
          </article>
          <article class="stack-item">
            <span>Framework</span>
            <strong>{{frameworkDisplay}}</strong>
          </article>
          <article class="stack-item">
            <span>Architecture</span>
            <strong>{{architectureDisplay}}</strong>
          </article>
          <article class="stack-item">
            <span>Database</span>
            <strong>{{databaseDisplay}}</strong>
          </article>
          <article class="stack-item">
            <span>ORM</span>
            <strong>{{ormDisplay}}</strong>
          </article>
          <article class="stack-item">
            <span>Cache</span>
            <strong>{{cacheDisplay}}</strong>
          </article>
          <article class="stack-item">
            <span>Tooling</span>
            <strong>{{toolingDisplay}}</strong>
          </article>
        </div>

        <div class="modules">
          <span>Resolved template modules</span>
          <code>{{selectedTemplates}}</code>
        </div>
      </section>
    </main>

    <footer>
      <div class="shell">
        Generated with
        <a href="https://github.com/yangxinpu/create-node-app">create-node-app</a>.
      </div>
    </footer>

    <script>
      const healthState = document.querySelector('#health-state')

      fetch('/health', { headers: { accept: 'application/json' } })
        .then((response) => {
          if (!response.ok) throw new Error(`HTTP ${response.status}`)
          return response.json()
        })
        .then((health) => {
          healthState.textContent =
            health.status === 'ok' ? 'Healthy /health endpoint' : 'Health endpoint responded'
        })
        .catch(() => {
          healthState.dataset.state = 'error'
          healthState.textContent = 'Health endpoint unavailable'
        })
    </script>
  </body>
</html>
